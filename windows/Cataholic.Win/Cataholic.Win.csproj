<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cataholic for Windows: the same cat as the Mac app, drawn in code with WPF.
       Builds on a Mac too (EnableWindowsTargeting); it only RUNS on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Cataholic</AssemblyName>
    <RootNamespace>Cataholic</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Cataholic</Product>
    <Copyright>© Manideep GNS</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- WFAC010 is a WinForms hint; WPF reads its DPI mode from app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sounds\*.wav" LogicalName="Sounds.%(Filename).wav" />
  </ItemGroup>
</Project>
